# --- Secrets (generate with: python hash_password.py) ----------------------
# A long random string used to sign JWTs. NEVER commit the real value.
JWT_SECRET=change-me-to-a-long-random-string

# Admin bootstrap. The password hash is Argon2 — generate it with the helper
# script. On first login you will be forced to set a new password and enable 2FA.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste-argon2-hash-here

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# --- Cookies ---------------------------------------------------------------
# Set to false ONLY for local http development. MUST be true in production.
COOKIE_SECURE=false

# --- Optional overrides ----------------------------------------------------
# DATABASE_PATH=recipes.db
# SUPPORTED_LOCALES=en,de,cs,jp
